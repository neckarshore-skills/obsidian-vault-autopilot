# Dependencies
node_modules/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Claude Code local config
.claude/*

# Editor
.vscode/
.idea/
*.swp
*.swo
*.bak

# Draft files (not for public release)
*.draft.md
*-draft.md

# Build output
dist/
build/
coverage/

# Package artifacts
*.tgz

# Lint cache
.eslintcache

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log

# Session-report skill output (generated artifacts, not source)
session-report-*.html

# Clone-cluster fixture generated notes (regenerate via tests/fixtures/clone-cluster/generate.sh)
tests/fixtures/clone-cluster/notes/

# Fixture cells are test material, never drafts — exempt from the draft-file
# patterns above (a *-draft.md fixture was silently excluded on 2026-06-11).
!tests/fixtures/**/*.md
!.claude/settings.json

# SDD build ledgers - local build material, never shipped and never cited as
# evidence a PR reviewer can open (#1779, ruling: way 2 - the verification chain
# is summarised in the PR body instead). The directory currently self-ignores via
# a nested .superpowers/sdd/.gitignore written by the tool; this line makes the
# intent the repo's own and survives that file going away.
.superpowers/
